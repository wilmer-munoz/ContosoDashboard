@page "/documents"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>My Documents</PageTitle>

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1>My Documents</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="NavigateToUpload">
                <i class="bi bi-upload"></i> Upload Document
            </button>
        </div>
    </div>

    <!-- Search and Filters -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search documents..." @bind="SearchTerm" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" @onclick="PerformSearch">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="SelectedCategory" @bind:after="OnFilterChanged">
                <option value="">All Categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="SortBy" @bind:after="OnFilterChanged">
                <option value="uploadDate">Sort by Date</option>
                <option value="title">Sort by Title</option>
                <option value="category">Sort by Category</option>
                <option value="size">Sort by Size</option>
            </select>
        </div>
    </div>

    <!-- Loading/Documents -->
    @if (IsLoading)
    {
        <div class="text-center">
            <p>Loading documents...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ErrorMessage
            <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="ClearError">Dismiss</button>
        </div>
    }
    else
    {
        <DocumentList Documents="UserDocuments" OnDownload="DownloadDocument" OnViewDetails="ViewDetails" />
        
        <!-- Pagination -->
        @if (TotalDocuments > PageSize)
        {
            <nav aria-label="Document pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @((CurrentPage <= 1) ? "disabled" : "")">
                        <a class="page-link" @onclick="() => ChangePage(CurrentPage - 1)" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    
                    @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == CurrentPage ? "active" : "")">
                            <a class="page-link" @onclick="() => ChangePage(i)">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @((CurrentPage >= TotalPages) ? "disabled" : "")">
                        <a class="page-link" @onclick="() => ChangePage(CurrentPage + 1)" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <div class="text-center text-muted mt-2">
                Showing @(((CurrentPage - 1) * PageSize) + 1) to @Math.Min(CurrentPage * PageSize, TotalDocuments) of @TotalDocuments documents
            </div>
        }
    }
</div>

@code {
    private List<Document>? UserDocuments;
    private bool IsLoading = true;
    private int CurrentUserId;
    private string SearchTerm = string.Empty;
    private string SelectedCategory = string.Empty;
    private string SortBy = "uploadDate";
    private List<string> Categories = new();
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalDocuments = 0;
    private string ErrorMessage = string.Empty;
    
    private int TotalPages => (int)Math.Ceiling((double)TotalDocuments / PageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userIdClaim) || !int.TryParse(userIdClaim, out CurrentUserId))
        {
            return;
        }

        await LoadCategories();
        await LoadDocuments();
    }

    private async Task LoadCategories()
    {
        // Get distinct categories from user's documents
        Categories = (await DocumentService.GetUserDocumentsAsync(CurrentUserId))
            .Select(d => d.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
    }

    private async Task LoadDocuments()
    {
        IsLoading = true;
        ErrorMessage = string.Empty;
        try
        {
            var result = await DocumentService.SearchDocumentsPaginatedAsync(
                SearchTerm, 
                CurrentUserId, 
                string.IsNullOrEmpty(SelectedCategory) ? null : SelectedCategory,
                null, // projectId
                null, // startDate
                null, // endDate
                SortBy,
                true, // sortDescending
                CurrentPage,
                PageSize
            );
            
            UserDocuments = result.Documents.ToList();
            TotalDocuments = result.TotalCount;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load documents: {ex.Message}";
            UserDocuments = new List<Document>();
            TotalDocuments = 0;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task PerformSearch()
    {
        CurrentPage = 1; // Reset to first page on new search
        await LoadDocuments();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            await LoadDocuments();
        }
    }

    private async Task OnFilterChanged()
    {
        CurrentPage = 1; // Reset to first page when filters change
        await LoadDocuments();
    }

    private void ClearError()
    {
        ErrorMessage = string.Empty;
    }

    private void NavigateToUpload()
    {
        Navigation.NavigateTo("/documents/upload");
    }

    private async Task DownloadDocument(Document doc)
    {
        // Implement download
        // For now, show message
        Console.WriteLine($"Download requested for: {doc.Title}");
    }

    private void ViewDetails(Document doc)
    {
        Navigation.NavigateTo($"/documents/{doc.Id}");
    }
}