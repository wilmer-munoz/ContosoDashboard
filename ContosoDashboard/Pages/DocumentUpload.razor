@page "/documents/upload"
@inject NavigationManager Navigation
@using ContosoDashboard.Models

<PageTitle>Upload Document</PageTitle>

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1>Upload Document</h1>
            <p class="text-muted">Upload files up to 25 MB in size</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <FileUpload OnDocumentUploaded="HandleDocumentUploaded" />
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">Allowed Files</h5>
                    <ul class="small mb-0">
                        <li>PDF (.pdf)</li>
                        <li>Word (.doc, .docx)</li>
                        <li>Excel (.xls, .xlsx)</li>
                        <li>PowerPoint (.ppt, .pptx)</li>
                        <li>Text (.txt)</li>
                        <li>Images (.jpg, .jpeg, .png)</li>
                    </ul>
                    <hr />
                    <p class="small mb-0"><strong>Max file size:</strong> 25 MB</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void HandleDocumentUploaded(Document document)
    {
        Navigation.NavigateTo($"/documents/{document.Id}");
    }
}