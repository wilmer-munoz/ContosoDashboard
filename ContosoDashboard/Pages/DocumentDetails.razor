@page "/documents/{documentId:int}"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Document Details</PageTitle>

<div class="container">
    @if (IsLoading)
    {
        <div class="text-center">
            <p>Loading document...</p>
        </div>
    }
    else if (Document == null)
    {
        <div class="alert alert-danger">
            Document not found or access denied.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @ErrorMessage
                <button type="button" class="btn-close" @onclick="ClearMessages"></button>
            </div>
        }
        
        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @SuccessMessage
                <button type="button" class="btn-close" @onclick="ClearMessages"></button>
            </div>
        }

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">@Document.Title</h3>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Document.Description))
                        {
                            <p class="card-text">@Document.Description</p>
                        }

                        <!-- File Preview Section -->
                        <div class="mb-4">
                            <h5>File Preview</h5>
                            @if (IsImageFile(Document.FileType))
                            {
                                <div class="text-center">
                                    <img src="/api/documents/@Document.Id/download" 
                                         alt="@Document.Title" 
                                         class="img-fluid rounded" 
                                         style="max-height: 300px;" 
                                         onerror="this.style.display='none';" />
                                    <p class="mt-2"><small class="text-muted">Image preview (if supported by browser)</small></p>
                                </div>
                            }
                            else if (Document.FileType.Contains("pdf"))
                            {
                                <div class="text-center p-4 border rounded">
                                    <i class="bi bi-file-earmark-pdf" style="font-size: 4rem; color: #dc3545;"></i>
                                    <p class="mt-2">PDF Document</p>
                                    <small class="text-muted">Preview not available - use download to view</small>
                                </div>
                            }
                            else
                            {
                                <div class="text-center p-4 border rounded">
                                    <i class="bi bi-file-earmark" style="font-size: 4rem; color: #6c757d;"></i>
                                    <p class="mt-2">@GetFileTypeDescription(Document.FileType)</p>
                                    <small class="text-muted">Preview not available - use download to view</small>
                                </div>
                            }
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Category:</strong> @Document.Category
                            </div>
                            <div class="col-md-6">
                                <strong>File Size:</strong> @GetFileSizeString(Document.FileSize)
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Uploaded:</strong> @Document.UploadDate.ToString("MMM dd, yyyy HH:mm")
                            </div>
                            <div class="col-md-6">
                                <strong>By:</strong> @Document.Uploader?.DisplayName
                            </div>
                        </div>

                        @if (Document.Project != null)
                        {
                            <div class="mb-3">
                                <strong>Project:</strong> @Document.Project.Name
                            </div>
                        }

                        <div class="mt-4">
                            <button class="btn btn-primary me-2" @onclick="DownloadDocument">
                                <i class="bi bi-download"></i> Download
                            </button>
                            @if (CanEdit)
                            {
                                <button class="btn btn-secondary me-2" @onclick="EditDocument">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                            }
                            @if (CanDelete)
                            {
                                <button class="btn btn-danger" @onclick="DeleteDocument">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Sharing Section -->
                @if (CanShare)
                {
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5>Share Document</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Share with user:</label>
                                <select class="form-select" @bind="SelectedUserId">
                                    <option value="0">Select user...</option>
                                    @foreach (var user in AvailableUsers)
                                    {
                                        <option value="@user.UserId">@user.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Permissions:</label>
                                <select class="form-select" @bind="SharePermissions">
                                    <option value="read">Read</option>
                                    <option value="download">Download</option>
                                </select>
                            </div>
                            <button class="btn btn-success" @onclick="ShareDocument" disabled="@(SelectedUserId == 0)">
                                Share
                            </button>
                        </div>
                    </div>
                }

                <!-- Shared With -->
                @if (Document.Shares != null && Document.Shares.Any())
                {
                    <div class="card">
                        <div class="card-header">
                            <h5>Shared With</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                @foreach (var share in Document.Shares)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        @share.SharedWithUser?.DisplayName
                                        <small class="text-muted">@share.Permissions</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Edit Document Modal -->
@if (ShowEditModal)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Document</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editTitle" class="form-label">Title</label>
                        <input type="text" class="form-control" id="editTitle" @bind="EditTitle" />
                    </div>
                    <div class="mb-3">
                        <label for="editDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editDescription" rows="3" @bind="EditDescription"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editCategory" class="form-label">Category</label>
                        <select class="form-select" id="editCategory" @bind="EditCategory">
                            <option value="General">General</option>
                            <option value="Project">Project</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Report">Report</option>
                            <option value="Contract">Contract</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editTags" class="form-label">Tags</label>
                        <input type="text" class="form-control" id="editTags" @bind="EditTags" placeholder="Comma-separated tags" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveDocumentChanges">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int DocumentId { get; set; }
    
    private Document? Document;
    private bool IsLoading = true;
    private int CurrentUserId;
    private bool CanEdit;
    private bool CanDelete;
    private bool CanShare;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private List<User> AvailableUsers = new();
    private int SelectedUserId;
    private string SharePermissions = "read";
    private bool ShowEditModal;
    private string EditTitle = "";
    private string EditDescription = "";
    private string EditCategory = "";
    private string EditTags = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrEmpty(userIdClaim) || !int.TryParse(userIdClaim, out CurrentUserId))
        {
            return;
        }

        await LoadDocument();
        await LoadAvailableUsers();
    }

    private async Task LoadDocument()
    {
        IsLoading = true;
        try
        {
            Document = await DocumentService.GetDocumentAsync(DocumentId, CurrentUserId);
            if (Document != null)
            {
                CanEdit = Document.UploaderId == CurrentUserId;
                CanDelete = CanEdit; // For now, only owner can delete
                CanShare = CanEdit;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load document: {ex.Message}";
            SuccessMessage = string.Empty;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadAvailableUsers()
    {
        // Load users that can be shared with (simplified - all users except current)
        // In real app, would filter by organization/team
        try
        {
            var allUsers = await DocumentService.GetUserDocumentsAsync(CurrentUserId); // This is wrong, need user service
            // For now, skip
        }
        catch
        {
            // Skip for now
        }
    }

    private async Task DownloadDocument()
    {
        try
        {
            Navigation.NavigateTo($"/api/documents/{Document.Id}/download", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading document: {ex.Message}");
        }
    }

    private void EditDocument()
    {
        if (Document != null)
        {
            EditTitle = Document.Title;
            EditDescription = Document.Description ?? "";
            EditCategory = Document.Category;
            EditTags = Document.Tags ?? "";
            ShowEditModal = true;
        }
    }

    private void CloseEditModal()
    {
        ShowEditModal = false;
    }

    private async Task SaveDocumentChanges()
    {
        if (Document == null) return;

        try
        {
            var metadata = new DocumentMetadata
            {
                Title = EditTitle,
                Description = string.IsNullOrEmpty(EditDescription) ? null : EditDescription,
                Category = EditCategory,
                ProjectId = Document.ProjectId,
                Tags = string.IsNullOrEmpty(EditTags) ? null : EditTags
            };

            await DocumentService.UpdateDocumentMetadataAsync(Document.Id, metadata, CurrentUserId);
            ShowEditModal = false;
            SuccessMessage = "Document updated successfully!";
            ErrorMessage = string.Empty;
            await LoadDocument(); // Refresh the document data
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to update document: {ex.Message}";
            SuccessMessage = string.Empty;
        }
    }

    private async Task DeleteDocument()
    {
        if (Document == null) return;
        
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this document?");
        if (!confirmed) return;

        try
        {
            await DocumentService.DeleteDocumentAsync(Document.Id, CurrentUserId);
            SuccessMessage = "Document deleted successfully!";
            ErrorMessage = string.Empty;
            await Task.Delay(1000); // Give user time to see success message
            Navigation.NavigateTo("/documents");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to delete document: {ex.Message}";
            SuccessMessage = string.Empty;
        }
    }

    private async Task ShareDocument()
    {
        if (Document == null || SelectedUserId == 0) return;

        try
        {
            await DocumentService.ShareDocumentAsync(Document.Id, SelectedUserId, SharePermissions, CurrentUserId);
            await LoadDocument(); // Refresh shares
            SelectedUserId = 0;
            SuccessMessage = "Document shared successfully!";
            ErrorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to share document: {ex.Message}";
            SuccessMessage = string.Empty;
        }
    }

    private string GetFileSizeString(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / (1024 * 1024)} MB";
    }

    private bool IsImageFile(string fileType)
    {
        return fileType.Contains("image/") || 
               fileType.Contains("jpg") || 
               fileType.Contains("jpeg") || 
               fileType.Contains("png") || 
               fileType.Contains("gif");
    }

    private string GetFileTypeDescription(string fileType)
    {
        if (fileType.Contains("pdf")) return "PDF Document";
        if (fileType.Contains("word") || fileType.Contains("doc")) return "Word Document";
        if (fileType.Contains("excel") || fileType.Contains("xls")) return "Excel Spreadsheet";
        if (fileType.Contains("powerpoint") || fileType.Contains("ppt")) return "PowerPoint Presentation";
        if (fileType.Contains("text")) return "Text File";
        return "Document";
    }

    private void ClearMessages()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
    }
}